const menu = [
  {
    title: "Главная",
    href: "#hero",
  },
  {
    title: "О компании",
    href: "#about",
  },
  {
    title: "Услуги",
    href: "#services",
  },
  {
    title: "Как мы работаем",
    href: "#process",
  },
  {
    title: "Отзывы",
    href: "#testimonials",
  },
  {
    title: "Контакты",
    href: "#contacts",
  },
