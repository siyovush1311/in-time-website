            w-11
            items-center
            justify-center
            rounded-xl
            border
            border-white/10
            bg-white/5
            text-white
            transition-all
            duration-300
            hover:border-cyan-400/40
            hover:bg-cyan-400/10
            lg:hidden
          "
        >
          {isOpen ? (
