              py-2.5
              text-sm
              font-semibold
              text-white
              shadow-[0_0_30px_rgba(37,211,102,.25)]
              transition-all
              duration-300
              hover:-translate-y-0.5
              hover:scale-105
              hover:bg-[#1EBE5D]
              hover:shadow-[0_0_45px_rgba(37,211,102,.45)]
